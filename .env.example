# Vercel → Project → Settings → Environment Variables (Production + Preview)
# NEXT_PUBLIC_* is exposed to the browser — do NOT put API secrets here.

# Mainnet payments: Vercel PI_API_KEY + /api/payments/* (Pass Pi pattern). SANDBOX optional (defaults mainnet).
NEXT_PUBLIC_PI_SANDBOX=false
# Legacy auth/user-state only — not used for Pi.createPayment checkout.
NEXT_PUBLIC_PI_BACKEND_URL=
# After new Developer Portal app — unlock product id + 3.141 π in Portal catalog
NEXT_PUBLIC_PEAKS_UNLOCK_PRODUCT_ID=

# Pi Developer Portal → API Keys (Vercel only; never NEXT_PUBLIC_* or git)
PI_API_KEY=

# Public app URL (Pi Portal Production URL + code-arche curator links)
NEXT_PUBLIC_PEAKS3141_URL=https://p-jeongs-projects-8253a162.vercel.app
NEXT_PUBLIC_VOICE3141_URL=https://v-jeongs-projects-8253a162.vercel.app
